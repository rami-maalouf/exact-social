// Exact Social: a publishing client for a self-hosted Postiz workspace.
// seam probe: the shapes and sources the view and the data module agree on.
routes nav
  publish "/"

shape Time
  epochAtZero: number
  utcOffset: number

shape Reply
  ok: bool
  error: string

// state: "none" (nothing saved), "ready" (the key answered), "error" (saved, but the last check failed).
shape Connection
  state: string
  instance: string
  workspace: string
  error: string

shape Choice
  value: string
  label: string

// one setting a network asks for. kind: "choice" | "text" | "bool" | "list".
shape Field
  key: string
  label: string
  kind: string
  options: Choice[]
  required: bool
  initial: string
  hint: string
  max: number

shape Channel
  id: string
  name: string
  handle: string
  network: string
  networkName: string
  avatar: string
  limit: number
  needsMedia: bool
  fields: Field[]

// kind: "image" | "video". `path` is a file on this device, `url` one the server holds.
shape Media
  id: string
  kind: string
  name: string
  path: string
  url: string

shape Setting
  key: string
  value: string

// status: "queue" | "draft" | "sent" | "error".
shape Post
  id: string
  group: string
  channelId: string
  text: string
  at: number
  status: string
  media: Media[]
  settings: Setting[]
  link: string
  error: string

shape Feed
  owner: string
  posts: Post[]

shape Target
  channelId: string
  text: string
  settings: Setting[]

shape Outcome
  channelId: string
  ok: bool
  error: string

shape Sent
  ok: bool
  error: string
  outcomes: Outcome[]

component App
  state now = 0
  resource time = exactTime() as shape Time
  resource connection = loadConnection() as shape Connection else empty()
  resource channels = loadChannels(connection.instance) as shape Channel[] else empty()
  resource feed = loadPosts(connection.instance, 0, 1) as shape Feed else empty()
  mutation connected as shape Reply refreshes connection, channels, feed
  mutation sent as shape Sent refreshes feed
  mutation removed as shape Reply refreshes feed
  action link(instance: string, key: string)
    send connected = connect(instance, key)
  action unlink
    send connected = disconnect()
  action post(mode: string, at: number, group: string, targets: Target[], media: Media[])
    send sent = submitPost(mode, at, group, targets, media, time.epochAtZero + performanceNow())
  action remove(id: string)
    send removed = deletePost(id)
  view
    main navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` position="absolute" inset=0
          text connection.state
