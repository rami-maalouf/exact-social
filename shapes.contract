// the shapes the view and the data module agree on.
shape Time
  epochAtZero: number
  utcOffset: number
  timeZone: string

shape Reply
  ok: bool
  error: string

// state: "none" (nothing saved), "ready" (the key answered), "error" (saved, but the last check failed).
shape Connection
  state: string
  instance: string
  workspace: string
  error: string

shape Choice
  value: string
  label: string

// one setting a network asks for. kind: "choice" | "text" | "bool" | "list".
shape Field
  key: string
  label: string
  kind: string
  options: Choice[]
  required: bool
  initial: string
  hint: string
  max: number

shape Channel
  id: string
  name: string
  handle: string
  network: string
  networkName: string
  avatar: string
  limit: number
  needsMedia: bool
  fields: Field[]
  // what the network takes beyond one post: more posts in a thread, a first comment, and how a
  // person or a company is mentioned: "none" | "typed" (an @name in the text) | "search" (found by findMentions).
  threads: bool
  comments: bool
  mentions: string

// kind: "image" | "video". `path` is a file on this device, `url` one the server holds.
shape Media
  id: string
  kind: string
  name: string
  path: string
  url: string
  // words for a person who cannot see it.
  alt: string

shape Setting
  key: string
  value: string

// status: "queue" | "draft" | "sent" | "error".
shape Post
  id: string
  group: string
  channelId: string
  text: string
  at: number
  status: string
  media: Media[]
  settings: Setting[]
  link: string
  error: string
  // the posts that follow this one in its thread, in order, and its first comment.
  thread: string[]
  comment: string

shape Feed
  owner: string
  posts: Post[]

shape Target
  channelId: string
  text: string
  settings: Setting[]
  thread: string[]
  comment: string

shape Outcome
  channelId: string
  ok: bool
  error: string

shape Sent
  ok: bool
  error: string
  outcomes: Outcome[]

// a post kept on this device, not yet on the server. timing: "now" | "later".
shape Draft
  id: string
  text: string
  channels: string[]
  media: Media[]
  settings: Setting[]
  tailored: Setting[]
  timing: string
  day: string
  clock: string
  updatedAt: number

shape Template
  id: string
  title: string
  text: string
  updatedAt: number

shape Kept
  ok: bool
  error: string
  media: Media[]

shape Instant
  at: number
  valid: bool

// one day of the week strip.
shape Day
  index: number
  key: string
  letter: string
  number: string
  count: number

// a post with the account it goes to, joined once for the list.
shape Row
  post: Post
  name: string
  avatar: string
  network: string
  hue: number

// a person or a company a post can mention. `token` is the text to put in the post for it.
shape Mention
  id: string
  name: string
  handle: string
  avatar: string
  token: string
